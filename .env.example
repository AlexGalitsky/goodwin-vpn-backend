DATABASE_URL=postgres://plane:plane@127.0.0.1:5432/plane?sslmode=disable
LISTEN=:8080
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too
PUBLIC_SUB_BASE=http://127.0.0.1:8080
# 1 only for local lab. Binary default is 0 (`go run` without this does not seed).
SEED_DEV=0

# Optional HTTPS POST for admin alerts (node down / cert / quota 90%).
ALERT_WEBHOOK=

# Agent (VPS / local)
AGENT_LISTEN=127.0.0.1:19400
AGENT_TOKEN=
AGENT_ALLOW_EXEC=1
AGENT_CONFIG=
